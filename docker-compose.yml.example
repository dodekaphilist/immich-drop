# Copy to docker-compose.yml, fill in the three required values, then: docker compose up -d
# Optional settings (see .env.example): copy it to .env next to this file; it is picked up automatically.
services:
  immich-drop:
    image: ghcr.io/dodekaphilist/immich-drop:latest
    container_name: immich-drop
    restart: unless-stopped
    ports:
      - 8080:8080
    environment:
      IMMICH_BASE_URL: https://immich.example.com
      PUBLIC_BASE_URL: https://drop.example.com
      SESSION_SECRET: change-me-to-a-long-random-string
    volumes:
      - immich_drop_data:/data

volumes:
  immich_drop_data:
