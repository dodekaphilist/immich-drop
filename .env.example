# Optional settings. Copy to .env next to docker-compose.yml; the compose file loads it if present.
# Everything is commented out with its default: uncomment only what you want to change.
# The required values (IMMICH_BASE_URL, PUBLIC_BASE_URL, SESSION_SECRET) are set in docker-compose.yml.
# Running without Docker (python main.py)? Set those three here instead.

# Listen address and port inside the container/process (change the port mapping in docker-compose.yml instead)
#HOST=0.0.0.0
#PORT=8080
# Auto-reload on code changes (development only)
#RELOAD=false

# Optional: one API key for everyone. Leave empty so every user saves their own key in the app's settings.
# Needs: asset.upload, album.read, album.create, albumAsset.create, user.read
#IMMICH_API_KEY=

# Album (optional): preselected for new links and downloads (created in the user's account if needed)
#IMMICH_ALBUM_NAME=

# Where the app keeps its data (state.db, chunks, cookies). Only for running without Docker:
# the image already uses the /data volume, and setting it here would override that.
#DATA_DIR=./data

# Log verbosity: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO

# Chunked uploads (to work around 100MB proxy limits)
# Enable to send files in chunks from browser to this service; the service reassembles and forwards to Immich.
# Recommended chunk size for Cloudflare Tunnel is <= 95MB.
#CHUNKED_UPLOADS_ENABLED=false
#CHUNK_SIZE_MB=95

# Instagram / gallery-dl anti-detection
# Sleep between HTTP requests during extraction (range in seconds, e.g. "10-25")
#GALLERY_DL_SLEEP_REQUEST=10-25
# Sleep before each file download (range in seconds)
#GALLERY_DL_SLEEP=5-15
# gallery-dl subprocess timeout (seconds); increase for large carousels
#GALLERY_DL_TIMEOUT=300
# Max concurrent URL downloads in batch mode (1 = serial, safest for Instagram)
#DOWNLOAD_CONCURRENCY=1
# Allow yt-dlp fallback for Instagram (false = blocked to reduce detection risk)
#INSTAGRAM_YTDLP_FALLBACK=false

# Disable social media uploads (optional) — enabled by default
#SOCIAL_MEDIA_UPLOADS_ENABLED=true

# Connection indicator (coloured dot) on the login page. Disable to hide it and stop /api/ping from
# probing Immich; set TEST_CONNECTION_SHOW_HOSTNAME=false to keep the dot but hide the Immich hostname.
#TEST_CONNECTION_ENABLED=true
#TEST_CONNECTION_SHOW_HOSTNAME=true

# iOS Shortcut / script endpoints (/api/upload/base64, /file, /batch, /urls). Off by default; when on, every user
# generates their own token in the app's settings and sends it as 'Authorization: Bearer <token>'. See docs/ios-shortcuts.md.
#SHORTCUT_ENABLED=false
